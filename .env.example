# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for development)
DATABASE_URL=sqlite:///./hospital_workforce.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/hospital_workforce

# ─── ML Model ─────────────────────────────────────────────────────────────────
MODEL_DIR=ml/saved_models
DEFAULT_MODEL=gru          # lstm | gru
FORECAST_HORIZON=24        # hours ahead to forecast
LOOKBACK_WINDOW=168        # hours of history to use (168 = 1 week)

# ─── Optimization ─────────────────────────────────────────────────────────────
ORTOOLS_MAX_SOLVE_TIME=30  # seconds
W1_SHORTAGE=10.0
W2_IMBALANCE=2.0
W3_OVERTIME=3.0
W4_PREF_VIOLATIONS=1.0

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
